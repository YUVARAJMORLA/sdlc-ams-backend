# ─────────────────────────────────────────────────
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# Never commit .env — it contains secrets!
# ─────────────────────────────────────────────────

# JWT signing secret (use a long random string in production)
JWT_SECRET=your-super-secret-jwt-key-here

# Supabase PostgreSQL - Session Pooler connection string
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Server port (Vercel ignores this — it assigns its own port)
PORT=3001

# Frontend URL for CORS (set to your Vercel frontend URL in production)
FRONTEND_URL=https://your-frontend.vercel.app

# AI Provider API Keys (set the one matching ACTIVE_AI_PROVIDER)
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# Active AI provider: openai | gemini | claude | ollama | expert
ACTIVE_AI_PROVIDER=gemini
